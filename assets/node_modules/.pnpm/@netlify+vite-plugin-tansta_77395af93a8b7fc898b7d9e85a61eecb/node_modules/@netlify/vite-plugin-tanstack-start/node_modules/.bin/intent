elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../@tanstack/react-start/bin/intent.js" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node  "$basedir/../../../../@tanstack/react-start/bin/intent.js" "$@"
elif [ -n "$exe" ] && command -v node.exe >/dev/null 2>&1; then
  exec node.exe  "$basedir_win/../../../../@tanstack/react-start/bin/intent.js" "$@"

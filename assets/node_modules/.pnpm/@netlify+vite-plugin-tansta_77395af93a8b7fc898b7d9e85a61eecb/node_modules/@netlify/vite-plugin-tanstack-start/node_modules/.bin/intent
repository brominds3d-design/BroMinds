else
  export NODE_PATH="/mnt/c/Users/tiago/Desktop/BroMinds/assets/node_modules/.pnpm/@tanstack+react-start@1.167_af290b6f8924515e0dc3538af3fcce3e/node_modules/@tanstack/react-start/node_modules:/mnt/c/Users/tiago/Desktop/BroMinds/assets/node_modules/.pnpm/@tanstack+react-start@1.167_af290b6f8924515e0dc3538af3fcce3e/node_modules:/mnt/c/Users/tiago/Desktop/BroMinds/assets/node_modules/.pnpm/node_modules:$NODE_PATH"
